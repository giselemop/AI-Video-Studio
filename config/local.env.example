# Copy this file to local.env and fill the existing MySQL account password.
# This file is process-local configuration. It is never committed or displayed in the UI.
AI_VIDEO_STUDIO_DB_HOST=127.0.0.1
AI_VIDEO_STUDIO_DB_PORT=3306
AI_VIDEO_STUDIO_DB_NAME=ai_video_studio
AI_VIDEO_STUDIO_DB_USER=ai_video_studio_app
AI_VIDEO_STUDIO_DB_PASSWORD=

# Schema creation and migrations are opt-in. Keep 0 until the operator has
# explicitly confirmed the formal database change window.
AI_VIDEO_STUDIO_AUTO_APPLY_SCHEMA=0

# Database creation is a separately guarded administrator operation. Keep 0
# for runtime/API accounts; pre-create the target database before migrations.
AI_VIDEO_STUDIO_ALLOW_DATABASE_CREATE=0

# High-cost tasks are rejected before execution when the target volume has
# less free space than this threshold (default 1 GiB).
AI_VIDEO_STUDIO_MIN_FREE_DISK_BYTES=1073741824

# Background workers are independently opt-in. Keep 0 for API-only health
# checks and until migration 008 is verified in the intended database.
AI_VIDEO_STUDIO_WORKER_ENABLED=0

# Optional override. The local app currently uses LocalAccess.RequireLogin=false
# for explicit loopback-only access. Setting this to 1 restores password login.
# AI_VIDEO_STUDIO_REQUIRE_LOGIN=1

# Optional: the first visit to the local login page can create these safely.
# The application persists only AI_VIDEO_STUDIO_ADMIN_PASSWORD_HASH, never a plaintext password.
# AI_VIDEO_STUDIO_ADMIN_USERNAME=studio-admin
# AI_VIDEO_STUDIO_ADMIN_PASSWORD_HASH=pbkdf2-sha512$210000$<salt>$<hash>
